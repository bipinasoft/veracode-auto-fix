# Copy to .env, fill in, then:  set -a; source .env; set +a
# Never commit the real .env file.

# Veracode
VERACODE_API_KEY_ID=
VERACODE_API_KEY_SECRET=
VERACODE_APP_NAME=my-service
# VERACODE_SANDBOX_NAME=feature-x     # default: sandbox named like the branch, else policy scan
# MIN_SEVERITY=3                       # 5 Very High ... 0 Informational
SRCCLR_API_TOKEN=

# Repository to fix (a local clone)
REPO_DIR=../my-service
TARGET_BRANCH=main
BUILD_CMD=mvn -B -q package -DskipTests
# TEST_CMD=mvn -B -q test
SCAN_ARTIFACT=target/my-service.jar
FIX_SOURCE_DIR=src/main/java

# AI fallback (optional)
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# AI_MAX_FINDINGS=20

# Local runs: keep everything on your machine
DRY_RUN=true
